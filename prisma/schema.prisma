generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  ACCOUNTING_REVIEW
  FINANCE_REVIEW
  APPROVED
  REJECTED
  PAYMENT_PENDING
  PAID
  LOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  CRITICAL
}

enum RuleType {
  APPROVAL
  RISK
  POLICY
  OCR
  FINANCE
  NOTIFICATION
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  passwordHash       String
  phone              String?
  title              String?
  isActive           Boolean     @default(true)
  mustChangePassword Boolean     @default(true)
  isPartner          Boolean     @default(false)
  departmentId       String?
  managerId          String?
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager            User?       @relation("Mgr", fields: [managerId], references: [id], onDelete: SetNull)
  directReports      User[]      @relation("Mgr")
  roles              UserRole[]
  expenses           Expense[]
  leaves             Leave[]
  approvals          Approval[]
  audits             AuditLog[]  @relation("Actor")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Department {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)
  users    User[]
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Leave {
  id        String   @id @default(cuid())
  userId    String
  type      String
  startDate DateTime
  endDate   DateTime
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Expense {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status       ExpenseStatus @default(DRAFT)
  expenseType  String
  expenseDate  DateTime
  companyName  String?
  documentDate DateTime?
  documentNo   String?
  receiptNo    String?
  taxBase      Decimal?      @db.Decimal(12, 2)
  vatAmount    Decimal?      @db.Decimal(12, 2)
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("TRY")
  paymentType  String?
  vehiclePlate String?
  customer     String?
  description  String?
  imagePath    String?
  riskLevel    RiskLevel     @default(LOW)
  riskScore    Int           @default(0)
  submittedAt  DateTime?
  paidAt       DateTime?
  lockedAt     DateTime?
  approvals    Approval[]
  payment      Payment?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Approval {
  id         String   @id @default(cuid())
  expenseId  String
  approverId String
  stepOrder  Int
  status     String   @default("PENDING")
  note       String?
  decidedAt  DateTime?
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approver   User     @relation(fields: [approverId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
}

model Rule {
  id              String     @id @default(cuid())
  name            String
  type            RuleType
  isActive        Boolean    @default(true)
  version         Int        @default(1)
  priority        Int        @default(100)
  expenseType     String?
  minAmount       Decimal?   @db.Decimal(12, 2)
  maxAmount       Decimal?   @db.Decimal(12, 2)
  countLimit      Int?
  periodDays      Int?
  riskLevel       RiskLevel?
  action          String
  requireNote     Boolean    @default(false)
  blockProcess    Boolean    @default(false)
  testMode        Boolean    @default(false)
  configJson      Json?
  validFrom       DateTime?
  validTo         DateTime?
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  expenseId   String   @unique
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime
  paidById    String
  note        String?
  receiptPath String?
  createdAt   DateTime @default(now())
}

model OcrUsage {
  id            String   @id @default(cuid())
  userId        String?
  provider      String
  openAiUsed    Boolean  @default(false)
  success       Boolean
  fileType      String?
  estimatedCost Decimal  @default(0) @db.Decimal(12, 6)
  tokens        Int?
  errorMessage  String?
  createdAt     DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  reason     String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}
