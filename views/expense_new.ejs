<%- include('partials_header') %>
<section class="card">
  <h1>Yeni Masraf</h1>
  <% if (typeof error !== 'undefined') { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/expenses" enctype="multipart/form-data" class="form grid2">
    <label>Başlık<input name="title" required placeholder="Örn: Müşteri ziyaret yakıt"></label>
    <label>Kategori<select name="category_id"><% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label>
    <label>Firma Ünvanı<input name="company_name"></label>
    <label>Belge Tarihi<input name="document_date" type="date"></label>
    <label>Belge Numarası<input name="document_number"></label>
    <label>Ara Toplam<input name="subtotal" type="number" step="0.01"></label>
    <label>KDV<input name="vat_amount" type="number" step="0.01"></label>
    <label>Toplam<input name="total_amount" type="number" step="0.01"></label>
    <label>Para Birimi<input name="currency" value="TRY"></label>
    <label>Fiş/Fatura<input name="receipt" type="file" accept="image/*,application/pdf" capture="environment"></label>
    <label class="full">Açıklama<textarea name="description" required></textarea></label>
    <button class="primary full">Kaydet</button>
  </form>
</section>
<%- include('partials_footer') %>
