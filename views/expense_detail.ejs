<%- include('partials_header') %>
<section class="card">
  <div class="page-head"><div><h1>Masraf #<%= expense.id %></h1><p><%= expense.title %></p></div><span class="pill"><%= expense.status %></span></div>
  <div class="detail-grid">
    <div><b>Personel</b><span><%= expense.user_name %></span></div>
    <div><b>Firma</b><span><%= expense.company_name || '-' %></span></div>
    <div><b>Belge Tarihi</b><span><%= expense.document_date || '-' %></span></div>
    <div><b>Belge No</b><span><%= expense.document_number || '-' %></span></div>
    <div><b>Ara Toplam</b><span><%= expense.subtotal %></span></div>
    <div><b>KDV</b><span><%= expense.vat_amount %></span></div>
    <div><b>Toplam</b><span><%= expense.total_amount %> <%= expense.currency %></span></div>
    <div><b>Risk</b><span class="pill <%= expense.risk_level %>"><%= expense.risk_level %></span></div>
  </div>
  <% if (expense.risk_notes) { %><div class="alert warning"><%= expense.risk_notes %></div><% } %>
  <p><b>Açıklama:</b> <%= expense.description %></p>
</section>

<section class="card">
  <h2>Fiş/Fatura</h2>
  <% if (receipts.length) { %>
    <% receipts.forEach(r => { %>
      <p><a class="linkbtn" target="_blank" href="/receipt/<%= r.id %>/view">Fişi Güvenli Görüntüle</a> <small><%= r.original_filename %></small></p>
      <button class="primary" id="ocrBtn" data-expense-id="<%= expense.id %>">OCR + AI Oku</button>
      <pre id="ocrResult"><%= r.ocr_text || '' %></pre>
      <% if (r.parsed_ai_json) { %><pre><%= r.parsed_ai_json %></pre><% } %>
    <% }) %>
  <% } else { %><p>Fiş eklenmemiş.</p><% } %>
</section>

<section class="card">
  <h2>Onay Akışı</h2>
  <% if (!approvals.length) { %><p>Henüz onaya gönderilmedi.</p><% } %>
  <% approvals.forEach(a => { %><div class="approval"><b><%= a.step_order %>. <%= a.role_name %></b><span class="pill"><%= a.action %></span><p><%= a.note || '' %></p></div><% }) %>

  <% if (expense.status === 'draft' && user.id === expense.user_id) { %>
    <form method="post" action="/expenses/<%= expense.id %>/submit"><button class="primary">Onaya Gönder</button></form>
  <% } %>

  <% if (current) { %>
    <form method="post" action="/expenses/<%= expense.id %>/decision" class="form">
      <label>Not<textarea name="note"></textarea></label>
      <button name="action" value="approved" class="primary">Onayla</button>
      <button name="action" value="rejected" class="danger">Reddet</button>
    </form>
  <% } %>

  <% if (expense.status === 'approved' && user.roles.includes('finans')) { %>
    <form method="post" action="/expenses/<%= expense.id %>/paid"><button class="primary">Ödendi İşaretle</button></form>
  <% } %>
</section>
<script src="/public/ocr.js"></script>
<%- include('partials_footer') %>
