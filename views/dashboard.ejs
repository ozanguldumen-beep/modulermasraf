<%- include('partials_header') %>
<div class="page-head">
  <div><h1>Dashboard</h1><p>Masraf kayıtları ve onay durumları</p></div>
  <a class="primary linkbtn" href="/expenses/new">+ Yeni Masraf</a>
</div>
<section class="card">
  <div class="table-wrap">
    <table>
      <thead><tr><th>ID</th><th>Personel</th><th>Başlık</th><th>Tutar</th><th>Risk</th><th>Durum</th><th>Tarih</th></tr></thead>
      <tbody>
      <% expenses.forEach(e => { %>
        <tr onclick="location.href='/expenses/<%= e.id %>'">
          <td>#<%= e.id %></td><td><%= e.user_name %></td><td><%= e.title %></td><td><%= e.total_amount %> <%= e.currency %></td>
          <td><span class="pill <%= e.risk_level %>"><%= e.risk_level %></span></td>
          <td><span class="pill"><%= e.status %></span></td><td><%= e.created_at %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials_footer') %>
