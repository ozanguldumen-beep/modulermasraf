<%- include('partials_header') %>
<section class="card">
  <h1>Kullanıcılar</h1>
  <form method="post" action="/admin/users" class="form grid2">
    <label>Ad Soyad<input name="name" required></label>
    <label>E-posta<input name="email" type="email" required></label>
    <label>Şifre<input name="password" value="ChangeMe123!"></label>
    <label>Departman<select name="department_id"><% departments.forEach(d => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></label>
    <div class="full checkgrid">
      <% roles.forEach(r => { %><label><input type="checkbox" name="roles" value="<%= r.name %>"> <%= r.name %></label><% }) %>
    </div>
    <button class="primary full">Kullanıcı Ekle</button>
  </form>
</section>
<section class="card">
  <div class="table-wrap"><table><thead><tr><th>Ad</th><th>E-posta</th><th>Departman</th><th>Aktif</th></tr></thead><tbody>
  <% users.forEach(u => { %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.department_name || '-' %></td><td><%= u.is_active ? 'Evet' : 'Hayır' %></td></tr><% }) %>
  </tbody></table></div>
</section>
<%- include('partials_footer') %>
